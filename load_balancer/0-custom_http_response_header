#!/usr/bin/env bash
# Installs Nginx and adds a custom X-Served-By header containing the server hostname
# shellcheck disable=SC2154

sudo apt-get update -y
sudo apt-get install -y nginx

# Default page so both servers respond with content
echo "Hello World!" | sudo tee /var/www/html/index.html > /dev/null

# Remove any previous X-Served-By lines so the header is never duplicated
sudo sed -i '/add_header X-Served-By/d' /etc/nginx/nginx.conf
sudo sed -i '/add_header X-Served-By/d' /etc/nginx/sites-available/default

# Add the custom header at the http level (hostname is expanded by bash at write time)
echo "add_header X-Served-By \"$(hostname)\";" | sudo tee /etc/nginx/conf.d/x-served-by.conf > /dev/null

# Validate config, then (re)start Nginx
sudo nginx -t
sudo service nginx restart
