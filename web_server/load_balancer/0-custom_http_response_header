#!/usr/bin/env bash
# Installs Nginx and adds a custom X-Served-By header containing the server hostname
# shellcheck disable=SC2154

apt-get update -y
apt-get install -y nginx

# Default page so both servers respond with content
echo "Hello World!" > /var/www/html/index.html

# Add the custom header at the http level (hostname is expanded by bash at write time)
echo "add_header X-Served-By \"$(hostname)\";" > /etc/nginx/conf.d/x-served-by.conf

# Validate config, then (re)start Nginx
nginx -t
service nginx restart
